<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      WHY THIS IS DECLARED HERE AND NOT ONLY IN THE APP:

      DeviceTools calls Vibrator.vibrate(), which requires android.permission.VIBRATE.
      That permission is already declared in the app manifest, so the merged
      manifest has it and the call works at runtime. But Android Lint analyses
      each library in isolation, and `:android`'s own manifest was an empty
      `<manifest/>`, so lint saw a vibrate() call with no permission declared
      and failed the build with MissingPermission.

      Declaring it here is the real fix rather than a suppression: `:android` is
      the module that actually makes the call, so this is where the requirement
      belongs. Manifest merging dedupes, and the app's own declaration stays as
      the record of what the final APK requests.

      The alternative — @SuppressLint or lintOptions abortOnError=false — would
      have silenced a genuine class of finding for every future permission used
      anywhere in this library.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      location.get calls LocationManager, which lint checks per library exactly like
      the VIBRATE call above, so the requirement is declared here too.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      timer.set sends AlarmClock.ACTION_SET_TIMER, which the clock app only accepts
      from an app holding SET_ALARM (a normal permission, granted at install).
      Without it Samsung's clock refused every timer with a SecurityException.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      Termux's RUN_COMMAND permission is protectionLevel "dangerous" and defined by Termux. An app that sends
      the RUN_COMMAND intent must declare it, and the user then switches it on under this app's Additional
      permissions. Without this line the permission is never granted and the Termux provider stays off.
    -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!--
      The Termux provider checks that Termux is installed (getPackageInfo) before it sends a command, which
      needs the package to be visible on Android 11 and later.
    -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!--
      Termux sends each command's result back to this receiver through a PendingIntent that this app made.
      It is not exported, so no other app can deliver a result to it.
    -->
    <application>
        <receiver
            android:name="dev.localintelligence.android.cloud.sandbox.TermuxResultReceiver"
            android:exported="false" />
    </application>

</manifest>
