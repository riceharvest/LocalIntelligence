<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Model inference is on-device. Network is only for the optional web.fetch tool. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the first-run screen say "you're on mobile data" before a large download. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Tool permissions. Each is requested lazily, only when a tool that needs
         it is actually invoked. See docs/tool-contract.md. -->
    <!-- Documents on Android 10 to 12. Android shows no dialog for a permission the manifest does not
         declare, so without this line the Permissions screen's Grant button does nothing there. From
         13 on the document grant comes through the file picker and this line is not used. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- location.get: coarse only, so the GPS provider stays refused and network/fused answer. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Texts and calls. Google Play allows the three permissions below only for the default
         assistant app, and the tools check that role on every call. Each is requested from the
         Permissions screen, and only while the role is held. -->
    <!-- sms.search: read the texts on the phone. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- sms.send: send a text, after the person confirms. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- calls.recent: read the call log. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- phone.call: place a call, after the person confirms. A normal runtime permission. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Special accesses. Android never shows a dialog for these: the person switches each on in a
         Settings screen, which the tool opens for them. The declarations make the app appear there. -->
    <!-- phone.dnd: Do Not Disturb access, which also makes phone.volume's silent mode work. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- phone.brightness: "Modify system settings". -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- device.screen_time: Usage access. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Agent execution runs in a foreground service so a long task survives
         the user switching apps. Android 14+ requires BOTH the base permission
         and the type-specific one, or startForegroundService throws. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Voice input: a clip for a model that reads audio, or live dictation into the
         composer for one that does not. Requested at first use from the mic button,
         never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Without this, SpeechRecognizer.isRecognitionAvailable reports false on API 30+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- phone.dial, maps.show, maps.navigate and contacts.add resolve these before opening
             them. Without the entries, API 30+ reports no app for them and the tools would
             wrongly say the phone cannot do it. Visibility only; no permission. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".LocalIntelligenceApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalIntelligence">

        <!-- LiteRT-LM GPU acceleration. LiteRT's GPU accelerator reaches the GPU
             through OpenCL, and Android's linker namespaces (API 24+) will not
             hand a vendor driver to an app that has not declared it. Without these
             two lines the GPU backend still runs: LiteRT logs "Failed to load
             OpenCL library with dlopen" and falls back internally, silently, to
             something slower than CPU. Declaring them is what makes the runtime's
             own capability probe honest instead of a guess.

             libOpenCL.so is the generic ICD soname; Adreno and Google Tensor ship
             libOpenCL-car.so / libOpenCL-pixel.so instead, which is why the
             capability probe checks all three. Both are declared
             required="false": a device legitimately may not have any of them, and
             a hard requirement would exclude it from the store rather than letting
             it run on CPU. See docs/acceleration.md. -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <!-- Google Tensor NPU (Pixel). LiteRT's Tensor dispatch library dlopen()s
             libedgetpu_litert.so, which loads the other three; Pixel 10 firmware
             lists all four in /vendor/etc/public.libraries.txt. Undeclared, the
             app's linker namespace refuses them and the NPU is unreachable. -->
        <uses-native-library
            android:name="libedgetpu_litert.so"
            android:required="false" />
        <uses-native-library
            android:name="libedgetpu_util.so"
            android:required="false" />
        <uses-native-library
            android:name="libedgetpu_client.google.so"
            android:required="false" />
        <uses-native-library
            android:name="libedgetpu_tachyon.google.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LocalIntelligence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Entry point for "share this file to LocalIntelligence". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- The launcher shortcut into the scheduled-tasks screen. Without
                 this declaration the shortcut in res/xml/shortcuts.xml is
                 silently dropped by the package parser and the feature is
                 unreachable — which is the same class of bug as an intent
                 filter that goes nowhere. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Agent task execution. Not exported: nothing outside the app may
             start it. Stops itself on every terminal result.

             The foregroundServiceType must match
             ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC in the service, or
             startForeground throws on API 34+. -->
        <service
            android:name=".ExecutionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps a model download running while the app is in the background. Started by
             HubTransfers when a download starts and stopped when it ends. The type must match
             ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC in DownloadService. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Long-polls Telegram while the Telegram plugin is on, so messages from a linked chat
             reach the agent with the app in the background. Started and stopped by TelegramService.sync;
             the type matches its startForeground call. -->
        <service
            android:name=".TelegramService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps the app alive while the browser is open for ChatGPT sign-in. Started and stopped
             by ChatGptSignInService's callers; the types match its startForeground call. -->
        <service
            android:name=".ChatGptSignInService"
            android:exported="false"
            android:foregroundServiceType="dataSync|shortService" />

        <!-- Shares a chat export. Only cacheDir/exports is covered (see
             res/xml/export_paths.xml), and the grant is per share, so no other
             app can read the transcript later. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- Delivers a fired alarm. Without this declaration alarm.create
             reports success for an alarm that will never ring. -->
        <receiver
            android:name="dev.localintelligence.android.tools.alarm.AlarmFireReceiver"
            android:exported="false" />

        <!-- Re-arms agent alarms after a reboot.

             A reboot clears every AlarmManager PendingIntent the app registered,
             so without this a 07:00 alarm silently stopped existing the moment
             the phone restarted — and alarm.list agreed with the lie, because
             the registry was in-memory only. RECEIVE_BOOT_COMPLETED was already
             declared above with no receiver listening for it.

             android:exported="false" is correct even though the broadcast comes
             from outside the app: BOOT_COMPLETED is a protected broadcast, so
             only the system can send it, and the platform skips the exported
             check for protected broadcasts. Keeping the filter narrow means no
             other app can trigger a re-arm. -->
        <receiver
            android:name="dev.localintelligence.android.tools.alarm.AlarmBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Fires a scheduled task, and re-arms every schedule after a reboot.

             The boot filters are the same two the agent-alarm receiver below
             uses, and the reason is the same: a reboot clears every
             AlarmManager PendingIntent the app registered. A schedule that
             silently stops existing while the UI still lists it is the exact
             failure this project treats as the worst kind of bug, and it is
             only avoidable because the receiver is declared here.

             One receiver rather than two: :android's AlarmBootReceiver already
             re-arms clock alarms from AlarmRegistry, but AlarmRegistry is a
             different store in a different module and AlarmSpec has no field
             for a task prompt, so it cannot re-arm these. Collapsing the two
             re-arm paths into a single receiver is a one-line follow-up for
             whoever owns :android; adding a second component for the same
             broadcast here was the worse trade.

             Not exported, and the filter is narrow: BOOT_COMPLETED is a
             protected broadcast, so only the system can send it, and the
             platform skips the exported check for protected broadcasts. No
             other app can make this app run an agent task. -->
        <receiver
            android:name=".execution.ScheduledTaskFireReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Where notification access is actually requested.

             The listener service above is bound by the system only after a human
             grants it in Settings, and nothing in an app can grant it for them.
             Until something asks, the feature is unreachable: the tools return
             an honest PermissionDenied, and the user has no way to act on it.
             This activity is that something.

             Not exported and no LAUNCHER category: it is reached from inside the
             app (and from a PendingIntent), not from the launcher. -->
        <activity
            android:name=".BackgroundAccessActivity"
            android:exported="false"
            android:label="@string/background_access_title"
            android:theme="@style/Theme.LocalIntelligence" />

        <!-- The permission screen: where a user the model told "grant Contacts"
             can actually grant it.

             Without this, the tools return an honest PermissionDenied naming
             android.permission.READ_CONTACTS and the exact Settings path, and
             the user has no way to act on that sentence. An honest refusal
             paired with a missing button is what made this an app that could
             never be told yes.

             Reached from inside the app, and from a launcher shortcut once
             res/xml/shortcuts.xml grows one (see the PR description for the
             exact entry, and for the exported=true that a shortcut requires).

             The label is a literal rather than a @string because strings.xml is
             owned by another workstream in this repo and a permission screen is
             not worth a merge conflict over. Moving it to a resource is a
             one-line follow-up.

             Not exported and no LAUNCHER category: an in-app destination, not
             a second icon on the home screen. -->
        <activity
            android:name=".ui.PermissionActivity"
            android:exported="false"
            android:label="Permissions"
            android:theme="@style/Theme.LocalIntelligence" />

        <!-- Required for notifications.list / notifications.reply. Android
             surfaces this as a Settings toggle, not a runtime prompt, so it
             cannot be requested with requestPermissions(). -->
        <service
            android:name="dev.localintelligence.android.tools.notifications.LocalNotificationListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Text-selection toolbar entry: "Ask LocalIntelligence".

             Transparent and display-less: it forwards the selected text to
             MainActivity through the same ACTION_SEND path a share uses, then
             finishes. exported=true is required because the text-selection
             toolbar of another app starts it. -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Ask LocalIntelligence"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Digital assistant (long-press Home / power button). The system binds
             the interaction service only after the user picks this app in
             Settings > Default apps > Digital assistant app. BIND_VOICE_INTERACTION
             is a system permission, so no other app can bind either service. -->
        <service
            android:name=".AssistantInteractionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assistant_interaction_service" />
        </service>
        <service
            android:name=".AssistantRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
        <service
            android:name=".AssistantSessionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- The overlay the assistant shows over the current app. Started by the
             session and by the ASSIST intent (the older assist gesture). Dialog
             theme so it floats over the app underneath. Exported because the
             system starts it. -->
        <activity
            android:name=".AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Ask LocalIntelligence"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile. Opens the chat from the shade. The
             BIND_QUICK_SETTINGS_TILE permission means only the system can bind
             it; no other app can start the service. -->
        <service
            android:name=".AssistantTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_assistant"
            android:label="LocalIntelligence"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
