<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Model inference is on-device. Network is only for the optional web.fetch tool. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tool permissions. Each is requested lazily, only when a tool that needs
         it is actually invoked. See docs/tool-contract.md. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Needed to read files the user picked via the Storage Access Framework
         and to search shared media. Scoped, not broad. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".LocalIntelligenceApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalIntelligence">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LocalIntelligence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Entry point for "share this file to LocalIntelligence". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          FileProvider. The ONLY way this app hands a file to another app.

          Three attributes, each load-bearing:

            android:exported="false"
              No other app may bind or query this provider directly. Access is
              only ever through a per-URI grant attached to a specific Intent,
              which is what grantUriPermissions below enables. Without
              exported="false" this would be a globally-readable window onto
              our private storage.

            android:grantUriPermissions="true"
              Required for a content:// URI to carry a FLAG_GRANT_*_URI_PERMISSION
              grant. This is what makes sharing revocable and per-URI: the grant
              dies with the Intent that carried it, so a share does not become a
              permanent capability.

          The authority is ${applicationId}.fileprovider rather than a literal.
          A provider authority is a device-global namespace; deriving it from the
          applicationId guarantees no collision with another app, and keeps a
          debug build from colliding with a release build on a shared device.

          The scope lives in res/xml/file_paths.xml, and that file declares
          exactly one path: <files-path name="out" path="out/" />. No
          root-path, no external-path, no cache-path, no whole-files-dir.
          ProviderPathScopeTest enforces that on the JVM.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          The SAF document-creation bridge. This is the manifest entry that
          makes files.write_text work on API 26-28: ACTION_CREATE_DOCUMENT
          delivers its result to an Activity, and an Activity cannot be
          registered at runtime, so it has to be declared here.

          exported="false": no other app may launch it. It is reached only from
          inside this process via an explicit component (see
          CreateDocumentActivity.intent), and it takes no caller-supplied data
          that a stranger could use to do anything a legitimate caller could not.
          There is deliberately no intent-filter, so nothing external can reach
          it — a share target would need exported="true" and a considered answer
          about which apps may invoke it, and this Activity is not a share entry
          point.

          noHistory is deliberately NOT set. It reads as the right instinct for
          a millisecond-lived Activity and is exactly wrong here: noHistory
          finishes the Activity as soon as it is no longer visible, which happens
          the moment the system picker covers it. The result would then be
          delivered to a dead Activity and onActivityResult would never run, so
          files.write_text would hang instead of returning. Every terminal path in
          the Activity already calls finish() (setResult + finish, or cancel()),
          so the back stack is left clean without it.
        -->
        <activity
            android:name=".document.CreateDocumentActivity"
            android:exported="false"
            android:theme="@style/Theme.LocalIntelligence.Transparent" />

    </application>

</manifest>
