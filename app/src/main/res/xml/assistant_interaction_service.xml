<?xml version="1.0" encoding="utf-8"?>
<!-- Declares LocalIntelligence to the system as a digital assistant. The
     recognition service is not implemented (no hotword or voice-input
     recognizer), so the session service is named here as well; the system
     binds it only for recognizer work this app does not do. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="dev.localintelligence.app.AssistantSessionService"
    android:recognitionService="dev.localintelligence.app.AssistantSessionService"
    android:supportsAssist="true" />
