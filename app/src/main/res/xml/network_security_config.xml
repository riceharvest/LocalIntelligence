<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext http:// is permitted by the platform so a model server or Home Assistant on the
  home network (192.168.x.x, 10.x, a .local name) can be reached: a domain-config matches
  names and exact addresses, never ranges, so a narrower rule cannot express "the LAN".

  The policy is enforced in the app instead, where the address is known:
  - Anything that sends a key or token (custom model endpoint, Home Assistant, MCP) accepts
    http:// only for loopback, .local and private IPv4 hosts (RemoteProvider's private-host
    check); a public host must be https.
  - web.fetch sends no credentials and fences every page as untrusted.
  System and user certificate trust are unchanged.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
