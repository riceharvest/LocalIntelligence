<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths the export FileProvider may hand out. cacheDir/exports, where ChatExporter
  writes a transcript before the share sheet takes it, and filesDir/crash, where
  CrashReports keeps the newest crash reports. A grant is read-only and lasts for
  that one share, so nothing else in the app's storage is reachable by another app.
-->
<paths>
    <cache-path name="exports" path="exports/" />
    <files-path name="crash" path="crash/" />
</paths>
