<?xml version="1.0" encoding="utf-8"?>
<!--
  A clock, drawn as a vector rather than pulled from an icon pack.

  WHY NOT material-icons-extended, which :app already depends on: those are
  Compose-side ImageVectors and cannot be referenced from a static shortcut
  XML, which needs a drawable resource. Pulling a second icon library in for one
  glyph would be a new dependency for one image, and an adaptive icon here
  would be rendered by the launcher at a size the vector has to guess at.

  One path, filled, matching the clock face the launcher draws around it. A
  vector is ~200 bytes and scales to every density without a second file.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2C6.5,2 2,6.5 2,12s4.5,10 10,10 10,-4.5 10,-10S17.5,2 12,2zM12,20c-4.4,0 -8,-3.6 -8,-8s3.6,-8 8,-8 8,3.6 8,8 -3.6,8 -8,8z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.5,7L11,7v6l5.2,3.2 0.8,-1.3 -4.5,-2.7z" />
</vector>
