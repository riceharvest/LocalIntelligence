    <!-- ScreenControlConsent.kt -->
    <string name="let_the_assistant_use_other_apps">Let the assistant use other apps?</string>
    <string name="screen_control_lets_the_assistant_read">Screen control lets the assistant read and act in an app on your screen. Read this before you turn it on.</string>
    <string name="what_it_reads">What it reads</string>
    <string name="only_the_app_in_front_during_a_request">Only the app in front, during a request that uses it: the text and buttons on that screen. It does not read your other apps in the background.</string>
    <string name="what_it_does">What it does</string>
    <string name="it_can_tap_type_scroll_and_press_back">It can tap, type, scroll and press Back or Home, but only in an app you approve for that request. It asks you again before any tap on a button such as send, pay, buy, delete, install or confirm.</string>
    <string name="what_it_never_does">What it never does</string>
    <string name="it_never_runs_unattended_or_in_the">It never runs unattended or in the background. It does not act in its own screens, Settings, or permission dialogs.</string>
    <string name="where_the_data_goes">Where the data goes</string>
    <string name="nothing_leaves_the_phone_because_of">Nothing leaves the phone because of screen control, unless you have set up a cloud model to answer the request. If one does, the text on that screen goes to that model\'s provider.</string>
