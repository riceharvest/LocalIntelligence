<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Full-build manifest overlay, merged over src/main/AndroidManifest.xml
         (docs/adr/0002-play-and-full-builds.md). Full-only permissions and the
         Accessibility service go here so the Play build's manifest never declares them. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- Photo search (the full build only): reads the photo library to caption it on this phone. The
         Play build never declares this, because Google Play limits it to apps whose core use needs it.
         Asked for at runtime on the Photo search screen, never at launch. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application>
        <!-- Screen control: off until the person switches the service on in Accessibility settings.
             The Settings setup card deep-links there (docs/adr/0003-screen-control-approval-per-app.md). -->
        <service
            android:name="dev.localintelligence.app.screen.ScreenControlService"
            android:exported="true"
            android:label="@string/screen_control_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_control_service" />
        </service>
    </application>
</manifest>
